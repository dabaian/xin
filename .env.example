# ==========================================================================
# Muse Studio 配置模板
#   复制成 .env 后按需修改：cp .env.example .env && chmod 600 .env
#   改完重启服务：systemctl restart muse-studio
# ==========================================================================

# ---------- 基础 ----------
APP_NAME=Muse Studio
APP_ENV=prod
# 留空则自动生成并存到 data/.secret（重启不失效）
SECRET_KEY=
BIND_HOST=127.0.0.1
BIND_PORT=8080

# 站点对外地址（含 https）。用于：
#   1) 生成参考图的公网签名链接（号池要能取到）
#   2) 支付宝回调地址兜底
# ⚠️ 必须填成外网可访问的域名，否则图生视频取不到参考图
PUBLIC_BASE=https://your-domain.com

# ---------- 目录 ----------
# DATA_DIR=/opt/muse-studio/data
# RELEASE_DIR=/opt/muse-studio/releases

# ---------- 管理员 ----------
# 首次启动会创建这个管理员账号。
# 部署时 install.sh 会自动填一个随机强密码并打印在屏幕上；
# 手工部署请务必在这里改成你自己的强密码（留空会退回到内置默认密码，只适合本地调试）。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------- 上游：muse2api 号池网关 ----------
# 复用现有上号链路：/v1/videos/generations、/v1/images/tasks、/v1/media/*
# 同机部署填 127.0.0.1；跨机填内网/公网地址
MUSE_BASE=http://127.0.0.1:18610
MUSE_KEY=这里填号池的 API Key
MUSE_MODEL=muse-video
MUSE_TIMEOUT=600
MUSE_POLL_INTERVAL=4
MUSE_VERIFY_SSL=1

# ---------- 计费 ----------
# 定价口径：1 元 = 10 积分；视频 2 积分/秒（5 秒 10、10 秒 20）；图片 5 积分/张
POINTS_PER_SECOND=2
POINTS_PER_IMAGE=5
SIGNUP_BONUS=20
MAX_ACTIVE_TASKS=2
ALLOW_REGISTER=1

# 充值套餐（JSON，price 单位是「分」）
# 不填则用内置：100/10元、500+50/50元、1200+200/120元、3000+800/300元
# RECHARGE_PACKAGES=[{"id":"starter","name":"体验包","points":100,"price":1000,"bonus":0,"tag":""}]

# ---------- 支付宝当面付（扫码充值） ----------
# 前置：支付宝开放平台 → 创建「网页/移动应用」→ 签约「当面付」→ 拿到 APPID 和密钥
ALIPAY_APP_ID=
# 应用私钥：推荐放文件里，避免 .env 里出现超长单行
ALIPAY_PRIVATE_KEY_PATH=/opt/muse-studio/secrets/alipay_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=/opt/muse-studio/secrets/alipay_public_key.pem
# 也可以直接内联（用 \n 表示换行）
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 异步通知地址：必须是公网 https，且不能被 Nginx 拦掉
ALIPAY_NOTIFY_URL=https://your-domain.com/api/payments/notify
ALIPAY_RETURN_URL=https://your-domain.com/wallet
ALIPAY_TIMEOUT=30m
# 模拟支付：没有商户密钥时用来验收流程，生产环境必须 0
ALIPAY_MOCK=0

# ---------- 桌面客户端 ----------
DESKTOP_VERSION=2.0.0
DESKTOP_SETUP_NAME=MuseStudio-Setup.exe

# ---------- 限流 ----------
RATE_LIMIT_PER_MIN=60
