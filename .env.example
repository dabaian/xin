# ==========================================================================
# Viora AI 配置模板
#   复制成 .env 后按需修改：cp .env.example .env && chmod 600 .env
#   改完重启服务：systemctl restart viora-ai
# ==========================================================================

# ---------- 基础 ----------
APP_NAME=Viora AI
APP_ENV=prod
# 留空则自动生成并存到 data/.secret（重启不失效）
SECRET_KEY=
BIND_HOST=127.0.0.1
BIND_PORT=8080

# 站点对外地址（含 https）。用于：
#   1) 生成参考图的公网签名链接（号池要能取到）
#   2) 支付宝回调地址兜底
# ⚠️ 必须填成外网可访问的域名，否则图生视频取不到参考图
PUBLIC_BASE=https://your-domain.com

# ---------- 目录 ----------
# DATA_DIR=/opt/viora-ai/data
# RELEASE_DIR=/opt/viora-ai/releases

# ---------- 注册验证码 ----------
# 注册页的图形验证码。默认开启；本地调试嫌麻烦可以设 0 关掉（线上别关）。
CAPTCHA_ENABLED=1
# 验证码有效期（秒），默认 5 分钟，用一次即作废
CAPTCHA_TTL=300

# ---------- 邮箱验证码（注册 / 验证码登录） ----------
# 注册和登录都要邮箱验证码，所以真实上线必须配 SMTP。
# 配了 SMTP 才会真发信；没配的话验证码发不出去，注册直接走不通，
# 程序在 APP_ENV=prod 时会因此拒绝启动（见 backend/app/guard.py）。
EMAIL_CODE_REQUIRED=1
# 验证码有效期（秒），默认 10 分钟
EMAIL_CODE_TTL=600
# 没有 SMTP 时是否把验证码回传给前端。
# 只能在本地调试时临时改成 1；APP_ENV=prod 时改成 1 会被启动守卫直接拦下。
MAIL_ECHO=0

# 发信服务器：QQ 邮箱 / 163 / 腾讯企业邮 / Gmail 都行
#
#   邮箱类型      SMTP_HOST            端口   密码填什么
#   QQ 邮箱       smtp.qq.com          465    QQ邮箱设置里生成的 16 位「授权码」
#   163 邮箱      smtp.163.com         465    163 设置里生成的「授权码」
#   腾讯企业邮    smtp.exmail.qq.com   465    「客户端专用密码」
#   Gmail         smtp.gmail.com       465    「应用专用密码」
#
# 465 端口 → SMTP_SSL=1 / SMTP_STARTTLS=0（推荐）
# 587 端口 → SMTP_SSL=0 / SMTP_STARTTLS=1
# 云服务器默认封 25 端口，别用
#
# 完整步骤（授权码怎么拿、报错怎么修）见 docs/邮件配置.md
# 填完重启后跑自检：cd backend && python tools/mailtest.py 你的邮箱@example.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 发件人显示地址，留空则用 SMTP_USER
SMTP_FROM=
# 465 端口走 SSL，一般 SMTP_SSL=1
SMTP_SSL=1
# 587 端口走 STARTTLS，这时设 SMTP_SSL=0 / SMTP_STARTTLS=1
SMTP_STARTTLS=0

# ---------- 管理员 ----------
# 首次启动会创建这个管理员账号。
# 部署时 install.sh 会自动填一个随机强密码并打印在屏幕上。
# 【必填】APP_ENV=prod 时留空会拒绝启动 —— 不再退回内置默认口令。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------- 上游：muse2api 号池网关 ----------
# 复用现有上号链路：/v1/videos/generations、/v1/images/tasks、/v1/media/*
# 同机部署填 127.0.0.1；跨机填内网/公网地址
MUSE_BASE=http://127.0.0.1:18610
MUSE_KEY=这里填号池的 API Key
MUSE_MODEL=muse-video
MUSE_TIMEOUT=600
MUSE_POLL_INTERVAL=4
MUSE_VERIFY_SSL=1
# 号池是 127.0.0.1 / 内网地址时必须直连；只有号池本身要走代理时才设 1
# （本机开着 Clash/V2Ray 且没设这里，常见症状是 502 upstream connect failed / os error 10061）
MUSE_USE_PROXY=0

# ---------- 计费 ----------
# 定价口径：1 元 = 10 积分；视频 2 积分/秒（5 秒 10、10 秒 20）；图片 5 积分/张
POINTS_PER_SECOND=2
POINTS_PER_IMAGE=5
SIGNUP_BONUS=20
MAX_ACTIVE_TASKS=2
ALLOW_REGISTER=1

# 充值套餐（JSON，price 单位是「分」）
# 不填则用内置：10/100积分、50/500、200/2000、500/5000、1000/10000、2000/20000（元/积分）
# 赠送不用手写：按金额自动算 —— 满 200 赠 10%、满 500 赠 15%、满 1000 赠 20%
# （确实要临时做活动时才在 JSON 里显式写 bonus，写了就以写的为准）
# 另外钱包页还有「自定义金额」入口，最低 10 元、最高 20000 元，走同一套赠送规则
# RECHARGE_PACKAGES=[{"id":"starter","name":"体验包","points":100,"price":1000,"tag":""}]

# ---------- 支付宝当面付（扫码充值） ----------
# 前置：支付宝开放平台 → 创建「网页/移动应用」→ 签约「当面付」→ 拿到 APPID 和密钥
ALIPAY_APP_ID=
# 应用私钥：推荐放文件里，避免 .env 里出现超长单行
ALIPAY_PRIVATE_KEY_PATH=/opt/viora-ai/secrets/alipay_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=/opt/viora-ai/secrets/alipay_public_key.pem
# 也可以直接内联（用 \n 表示换行）
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 异步通知地址：必须是公网 https，且不能被 Nginx 拦掉
ALIPAY_NOTIFY_URL=https://your-domain.com/api/payments/notify
ALIPAY_RETURN_URL=https://your-domain.com/wallet
ALIPAY_TIMEOUT=30m
# 模拟支付开关。生产环境（APP_ENV=prod）打开这个值会直接拒绝启动，
# 不是打日志提醒 —— 开着它等于白送积分。只在本地验收时临时设 1。
ALIPAY_MOCK=0

# 支付通道：
#   alipay  支付宝当面付（真实收款，需要上面 4 个参数齐全）
#   none    明确关闭充值（钱包页会提示「充值通道未开通」）
#   留空    自动：支付宝参数齐全就用支付宝，否则判定为「充值不可用」
#           —— 不会偷偷回落到模拟通道
#   mock    模拟通道，仅非生产环境可用；生产填 mock 会被启动守卫拦下
# 接微信、易支付等新通道：在 backend/app/payments/ 里加一个适配器 + 注册一行，
# 再把这里设成对应 code 即可，业务代码和前端都不用改。详见 docs/接入说明.md
PAYMENT_CHANNEL=

# ---------- 前后端分离 / 对外接入 ----------
# 后端 API 对外前缀（默认空）。后端挂在子路径（https://x.com/viora/api）时填 /viora
API_BASE=
# 前端与后端不同域时，把前端域名写在这里才会放开跨域请求（逗号分隔）
# 带登录态的跨域必须写具体域名，不能填 *；并且站点要 HTTPS
CORS_ORIGINS=

# ---------- 桌面客户端 ----------
DESKTOP_VERSION=2.0.0
DESKTOP_SETUP_NAME=VioraAI-Setup.exe

# ---------- 限流 ----------
RATE_LIMIT_PER_MIN=60
