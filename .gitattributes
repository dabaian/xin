# 统一换行符：Linux 服务器上 clone 下来不能出现 CRLF，否则 .sh 会报 /\r 错误
* text=auto

*.sh        text eol=lf
*.py        text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.example   text eol=lf
Dockerfile  text eol=lf

*.bat       text eol=crlf
*.ps1       text eol=crlf

*.ico       binary
*.png       binary
*.jpg       binary
*.svg       text eol=lf
*.zip       binary
*.gz        binary
*.exe       binary
