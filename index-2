<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>今日宇宙签 · 一个有点神秘的小网站</title>
  <style>
    :root { --bg:#090b1c; --panel:rgba(19,24,55,.72); --text:#f4f5ff; --muted:#aeb4d7; --a:#8f7cff; --b:#47d7ff; --glow:rgba(143,124,255,.35); }
    *{box-sizing:border-box} body{margin:0;color:var(--text);font-family:Inter,system-ui,"Microsoft YaHei",sans-serif;background:radial-gradient(circle at 20% 10%,#253a72 0,transparent 32%),radial-gradient(circle at 90% 80%,#321b54 0,transparent 35%),var(--bg);min-height:100vh;overflow-x:hidden}
    body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.55;background-image:radial-gradient(#fff 1px,transparent 1px);background-size:80px 80px;mask-image:linear-gradient(to bottom,black,transparent 90%)}
    .wrap{width:min(1080px,92%);margin:auto;padding:34px 0 60px}.top{display:flex;justify-content:space-between;align-items:center;gap:18px}.brand{letter-spacing:.08em;font-weight:800}.brand span{color:var(--b)}button{font:inherit;color:var(--text);border:1px solid #ffffff33;background:#ffffff12;border-radius:999px;padding:10px 16px;cursor:pointer;transition:.2s}button:hover{transform:translateY(-2px);background:#ffffff22}.hero{text-align:center;padding:74px 12px 42px}.eyebrow{color:var(--b);font-size:13px;letter-spacing:.22em;text-transform:uppercase}.hero h1{font-size:clamp(42px,8vw,84px);line-height:.98;margin:18px 0;background:linear-gradient(100deg,#fff,var(--b),#bca8ff);-webkit-background-clip:text;color:transparent}.hero p{color:var(--muted);font-size:17px;margin:0 auto 28px;max-width:580px}.mainbtn{font-weight:800;border:0;padding:15px 24px;background:linear-gradient(100deg,var(--a),#586dff);box-shadow:0 12px 36px var(--glow)}.mainbtn:hover{box-shadow:0 16px 42px var(--glow)}.grid{display:grid;grid-template-columns:1.1fr .9fr;gap:18px}.card{background:var(--panel);border:1px solid #ffffff1c;border-radius:24px;padding:26px;backdrop-filter:blur(16px);box-shadow:0 20px 70px #0003}.label{font-size:12px;letter-spacing:.15em;color:var(--muted);text-transform:uppercase}.answer{min-height:230px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center}.planet{font-size:88px;filter:drop-shadow(0 0 26px var(--glow));animation:float 4s ease-in-out infinite}.answer h2{margin:10px 0 8px;font-size:30px}.answer p{color:var(--muted);margin:0;line-height:1.7}.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:20px}.stat{padding:17px;border-radius:16px;background:#ffffff0b}.stat b{display:block;margin-top:8px;font-size:18px}.log{margin:0;padding:0;list-style:none}.log li{display:flex;gap:12px;padding:14px 0;border-bottom:1px solid #ffffff12;color:var(--muted);line-height:1.5}.log li:last-child{border:0}.dot{width:9px;height:9px;flex:0 0 9px;margin-top:8px;border-radius:50%;background:var(--b);box-shadow:0 0 15px var(--b)}footer{text-align:center;color:#858bb1;font-size:13px;margin-top:34px} @keyframes float{50%{transform:translateY(-9px) rotate(3deg)}} @media(max-width:760px){.grid{grid-template-columns:1fr}.hero{padding-top:55px}.top{align-items:flex-start}}
  </style>
</head>
<body>
  <main class="wrap">
    <header class="top"><div class="brand">✦ <span>宇宙签</span> / DAILY ORACLE</div><button id="theme">切换星系</button></header>
    <section class="hero"><div class="eyebrow">你的今日宇宙频道已接通</div><h1>今天，宇宙<br/>想告诉你什么？</h1><p>不用登录，不收集数据。按下按钮，让一颗随机星球替你翻开今天的隐藏任务。</p><button class="mainbtn" id="draw">✦ 抽一张今日宇宙签</button></section>
    <section class="grid">
      <article class="card answer"><div class="label">今日信号 · <span id="date"></span></div><div class="planet" id="planet">🌌</div><h2 id="title">等待宇宙发牌</h2><p id="quote">准备好了吗？你今天的答案，可能比你想象的更离谱。</p><div class="stats"><div class="stat"><span class="label">幸运色</span><b id="color">—</b></div><div class="stat"><span class="label">隐藏任务</span><b id="task">—</b></div></div></article>
      <article class="card"><div class="label">宇宙电台 · 最近收到的信号</div><ul class="log" id="log"><li><i class="dot"></i><span>宇宙正在校准你的今日频率……</span></li><li><i class="dot"></i><span>一颗小行星刚刚路过，顺便留下了好运。</span></li><li><i class="dot"></i><span>提示：认真对待随机性，它偶尔很懂你。</span></li></ul></article>
    </section>
    <footer>Made for curious humans · 刷新页面也不会丢失你的宇宙签</footer>
  </main>
  <script>
    const data=[
      ['🪐','慢速土星','今天适合把一件小事做完，不必一次解决整个宇宙。','薄荷绿','给一个很久没联系的人发个表情'],
      ['🌙','月亮背面','你不需要向所有人解释自己。安静也是一种答案。','午夜蓝','关掉通知 20 分钟'],
      ['☄️','彗星快线','一个突然的念头值得被记录，它可能是新路线的入口。','流星银','写下三个想做但没做的事'],
      ['🌈','彩虹卫星','今天的好运藏在一次不经意的尝试里。先试试看。','桃子橙','尝试一个平时不会点的选项'],
      ['🛰️','失重电台','别把暂时的卡顿误认为失败，信号还在，只是正在重连。','极光紫','给自己安排一段无目的散步']
    ];
    const $=id=>document.getElementById(id); $('date').textContent=new Date().toLocaleDateString('zh-CN',{month:'long',day:'numeric'});
    function draw(){const x=data[Math.floor(Math.random()*data.length)]; $('planet').textContent=x[0];$('title').textContent=x[1];$('quote').textContent=x[2];$('color').textContent=x[3];$('task').textContent=x[4];const li=document.createElement('li');li.innerHTML='<i class="dot"></i><span>已收到来自「'+x[1]+'」的新信号。</span>';$('log').prepend(li);if($('log').children.length>4)$('log').lastElementChild.remove();}
    $('draw').onclick=draw; $('theme').onclick=()=>{document.body.style.setProperty('--a',['#ff6b9d','#7ee7c6','#ffb86b'][Math.floor(Math.random()*3)]);document.body.style.setProperty('--b',['#7ddcff','#ffe27d','#d6a4ff'][Math.floor(Math.random()*3)]);draw()};
  </script>
</body>
</html>
